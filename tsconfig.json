{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowJs": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "src/**/*",
    "scripts/**/*.ts"
  ]
}
